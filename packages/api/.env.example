# LoRaMINT API - example configuration.
# Copy to .env and fill in the values. Every variable the application reads is
# listed here; the commented-out ones are optional and show their default.

#====================================
# Core
#====================================

# Postgres connection, read by bun's built-in `sql` client. Required.
DATABASE_URL=postgres://loramint:loramint@localhost:5432/loramint

# How many reverse proxies sit in front of this server. Only the login throttle
# uses it, and only to tell one visitor from another: behind Traefik every
# request arrives from Traefik, so with 0 the throttle would count all visitors
# as one and six wrong passwords anywhere would lock the whole site out.
#
#   0  no proxy - use the connection's own address and ignore X-Forwarded-For.
#      Correct for a server reachable directly, where that header is simply
#      whatever the client felt like writing.
#   1  the default, and what compose.prod.yml sets up: Traefik and nothing else.
#   2  a CDN in front of Traefik, and so on - one per hop.
#
# Only safe while the container cannot be reached around the proxy.
# TRUSTED_PROXIES=1

#====================================
# SQL page (optional)
#====================================

# Connection used by the /sql page for everyone who is not an administrator.
# Optional: without it the page does not exist. It must NOT be the connection
# above.
#
# The reason is not tidiness. DATABASE_URL owns the schema and, in the default
# Docker setup, is a superuser, and queries on such a connection cannot be made
# read-only: wrapping them in a READ ONLY transaction stops writes, but not
# `pg_read_file()`, not reading password hashes from `pg_authid`, and not
# running shell commands through `COPY ... TO PROGRAM` - none of those write to
# the database. The transaction itself can also just be ended with `COMMIT;`,
# after which the rest of the query runs read-write.
#
# So the page runs as a role that may only SELECT and that has
# `default_transaction_read_only = on` set on the role itself. Create it with
#     docker exec -i loramint_postgres psql -U loramint -d loramint \
#       -v password=readonly < dev_scripts/create-readonly-role.sql
# DATABASE_URL_READONLY=postgres://loramint_readonly:readonly@localhost:5432/loramint

# Connection used by the same /sql page when an administrator opens it, so that
# one may write. Optional: without it the console does
# not exist. It must not be DATABASE_URL either, and the server refuses to start
# if it is: that role is a superuser in the default setup, which would turn the
# console into shell access on the database host (COPY ... TO PROGRAM). The role
# below may read and write the application's tables and nothing else - notably
# it cannot change the schema, which stays with the migrations. Create it with
#     docker exec -i loramint_postgres psql -U loramint -d loramint \
#       -v password=adminsql < dev_scripts/create-admin-role.sql
# DATABASE_URL_ADMIN=postgres://loramint_admin_sql:adminsql@localhost:5432/loramint

# How many rows a result may show, on both pages. Default: 200
#
# The cap is applied inside the database, so raising it costs page weight and
# rendering time, not database work. Measured on this machine with a three-column
# result: 200 rows are 48 KB, 1000 are 183 KB, 5000 are 863 KB, 20000 are 3.4 MB.
# Above roughly 2000 the page stops being something you read and becomes
# something you scroll - use the CSV export for that.
# QUERY_MAX_ROWS=200

# After how many milliseconds a statement is cancelled. Default: 5000
# The database roles carry their own limit as well, so this can only tighten it.
# QUERY_TIMEOUT_MS=5000

# Shared secret for the TTN webhook: TTN sends it as the X-Downlink-Apikey
# header and requests that do not match are rejected. Required.
TTN_APP_KEY=your-ttn-api-key

# HTTP port. Default: 8090
PORT=8090

# "development" enables the SSR dev overlay and drops the Secure flag from the
# session cookie so it works over plain http. Anything else, including unset,
# is treated as production.
# NODE_ENV=development

#====================================
# Data management (optional)
#====================================

# Connection the management pages ("Verwaltung > Daten verwalten") write
# through. Optional, and its absence is not an error: without it those pages
# still open and can be searched and filtered, but not edited - they say so.
#
# Reading stays on DATABASE_URL like everywhere else; only changes and deletions
# use this role. The reason is the change log: the pages have to append to
# audit_log but must never be able to rewrite it, and that is a property of the
# database role, not a promise the page makes about itself. So this role holds
# SELECT and INSERT on audit_log and nothing more, while it may fully read and
# write measurements and log_entries. Correcting a log entry is therefore only
# possible through the SQL console as an administrator.
#
# It must not be DATABASE_URL, and the server refuses to start if it is.
#
# The container creates the role itself on startup (scripts/ensure-roles.ts, run
# after the migrations, for this and the two roles above). To do it by hand:
#     docker exec -i loramint_postgres psql -U loramint -d loramint \
#       -v password=managepw < dev_scripts/create-manage-role.sql
# DATABASE_URL_MANAGE=postgres://loramint_manage:managepw@localhost:5432/loramint

# Largest number of rows a single delete may remove. Default: 10000
# Beyond this the page asks for a narrower filter instead: a deletion that runs
# for minutes holds locks on the table the webhook is inserting into.
# MANAGE_MAX_DELETE=10000

# After how many milliseconds a management statement is cancelled.
# Default: 30000. Longer than QUERY_TIMEOUT_MS on purpose - deleting a whole
# faulty measurement series legitimately takes a while.
# MANAGE_TIMEOUT_MS=30000

#====================================
# Legal pages (optional)
#====================================

# Each page only exists, and only appears in the "Kontakt" nav dropdown, when
# its variable is set. Use \n for line breaks.
# LEGAL_IMPRESSUM=Musterschule\nMusterstraße 1\n12345 Musterstadt
# LEGAL_DATENSCHUTZ=Es werden keine personenbezogenen Daten gespeichert.

#====================================
# Login (optional, LDAP)
#====================================

# The login is opt-in: without LDAP_URL there is no /login route and no login
# button, and the site behaves exactly as before. Setting it makes
# SESSION_SECRET and one of the two bind strategies below mandatory - the
# server then refuses to start rather than failing at every sign-in attempt.
#
# For a directory to develop against, see
# packages/api/dev_scripts/ldap/README.md - a throwaway OpenLDAP container with
# test users, ready-made settings for both strategies below, and a group the
# search filter can restrict on.

# Directory URL. Use ldaps:// in production; a plain ldap:// bind sends the
# password across the network in the clear.
# LDAP_URL=ldaps://ldap.example.org:636

# --- Strategy 1: direct bind ----------------------------------------------
# Builds the user's DN from the login name and binds with it. Needs no service
# account, but the DN has to be derivable from the login name.
# {username} is the only placeholder and is escaped per RFC 4514.
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=org

# --- Strategy 2: search and bind ------------------------------------------
# A service account looks the user up first, then the DN that was found is
# bound with the submitted password. Use this to allow logging in by mail
# address, or to restrict access to a group - the filter is where you say so.
# LDAP_BIND_DN=cn=service,ou=system,dc=example,dc=org
# LDAP_BIND_PASSWORD=change-me
# LDAP_SEARCH_BASE=ou=people,dc=example,dc=org
# {username} is escaped per RFC 4515. Default: (uid={username})
# Quote it: bun reads the value either way, but the `&` makes an unquoted line
# a syntax error for `set -a; . .env`, which silently leaves the filter unset.
# LDAP_SEARCH_FILTER='(&(uid={username})(memberOf=cn=loramint,ou=groups,dc=example,dc=org))'
#
# Note on memberOf: Active Directory provides it out of the box, but in OpenLDAP
# it is an overlay that has to be loaded - without it the filter above silently
# matches nothing and every login fails. If the directory does not have it,
# restrict on an attribute of the user entry instead, for example
#   LDAP_SEARCH_FILTER='(&(uid={username})(employeeType=loramint))'
# A filter matching more than one entry is refused rather than guessed at.

# --- Optional tuning -------------------------------------------------------

# Attribute shown as the name in the header; falls back to the login name when
# the entry does not have it. Default: cn
# LDAP_DISPLAY_NAME_ATTRIBUTE=displayName

# --- Group membership ------------------------------------------------------
# Groups decide which queries a user may run on /sql (see services/catalog.ts).
# Without either option below users hold no groups, and only see the queries
# that are open to everyone.
#
# Groups are read once, at sign-in, and travel in the session cookie: removing
# someone from a group takes effect when their session expires, not instantly.
#
# Option A - an attribute on the user entry. Active Directory provides memberOf
# out of the box; OpenLDAP only with the memberof overlay loaded. Full DNs are
# reduced to the group name, so cn=lehrer,ou=groups,... becomes "lehrer".
# LDAP_GROUP_ATTRIBUTE=memberOf
#
# Option B - search the group entries for the ones listing this user. Works with
# plain groupOfNames and needs no overlay. {dn} is the user's DN, escaped.
# LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=org
# Quote it, like LDAP_SEARCH_FILTER. Default: (member={dn})
# For posixGroup entries use '(memberUid={username})'.
# LDAP_GROUP_FILTER='(member={dn})'
# Attribute holding the group name. Default: cn
# LDAP_GROUP_NAME_ATTRIBUTE=cn

# --- Privileges ------------------------------------------------------------
# Three levels, each containing the one below it:
#
#   LDAP_DATA_GROUP        read-only: "Daten > SQL".
#   LDAP_MANAGEMENT_GROUP  the above, plus "Verwaltung" - editing measurements
#                          and devices.
#   LDAP_ADMIN_GROUP       the above, plus the SQL page on a connection that may
#                          write.
#
# Because it is a ladder, one group per person is enough: an administrator does
# not also have to be in the other two. A model where you can forget to grant a
# lower level is one that gets got wrong eventually.
#
# The defaults are not symmetric, on purpose. Unset LDAP_DATA_GROUP means "no
# restriction configured", so every signed-in user keeps the read-only page and a
# deployment that never set up groups is not locked out. Unset
# LDAP_MANAGEMENT_GROUP or LDAP_ADMIN_GROUP mean nobody reaches those levels:
# editing rights and write access are never handed out by accident.
# LDAP_DATA_GROUP=loramint
# LDAP_MANAGEMENT_GROUP=loramint-management
# LDAP_ADMIN_GROUP=loramint-admin

# Where "Passwort vergessen?" points. Password resets belong to the directory,
# not to this application, so link to whichever portal owns them. Without it
# the form shows a note to contact the administration instead.
# LDAP_PASSWORD_RESET_URL=https://portal.example.org/passwort

# Set to false ONLY against a test directory with a self-signed certificate.
# Default: true
# LDAP_TLS_REJECT_UNAUTHORIZED=true

# Connect and response timeout in milliseconds. Default: 5000
# LDAP_TIMEOUT_MS=5000

#====================================
# Sessions (required once the login is enabled)
#====================================

# Signing key for the session cookie, at least 32 characters. Generate one with
#     openssl rand -base64 48
# The cookie is signed rather than encrypted, so this must stay out of version
# control. Rotating it invalidates every existing session - and since no
# sessions are stored server-side, that is also the only way to revoke them.
# SESSION_SECRET=

# How long a session stays valid, in hours. Default: 8
# SESSION_TTL_HOURS=8
